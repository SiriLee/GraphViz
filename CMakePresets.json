{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gui",
      "displayName": "GUI (Qt 6)",
      "description": "Build with Qt6 GUI support (set CMAKE_PREFIX_PATH in CMakeUserPresets.json if Qt is not in system path)",
      "binaryDir": "${sourceDir}/build-gui",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gui",
      "configurePreset": "gui"
    },
    {
      "name": "release",
      "displayName": "Release (GUI)",
      "description": "Optimized release build",
      "configurePreset": "gui",
      "configuration": "Release"
    }
  ]
}
